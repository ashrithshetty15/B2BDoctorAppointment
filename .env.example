# ---- Core ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Postgres (managed instance in prod) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinicbot?schema=public

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379
# BullMQ key namespace. Override when another instance shares this Redis, or the
# two workers will consume each other's jobs.
REDIS_QUEUE_PREFIX=bull

# ---- Messaging adapter ----
# whatsapp_cloud | console   (console = log outbound to stdout, for local dev/tests)
MESSAGING_PROVIDER=console

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
# Default sender used when a Doctor has no whatsappPhoneNumberId of its own
WHATSAPP_PHONE_NUMBER_ID=
# Value you type into the Meta webhook config screen
WHATSAPP_VERIFY_TOKEN=change-me
# Meta App Secret - enables X-Hub-Signature-256 verification. Leave blank to skip (dev only).
WHATSAPP_APP_SECRET=
# Approved Meta template for follow-up reminders. Unset means due follow-ups stay
# pending and visible in the console rather than being attempted and dropped:
# they always fall outside the 24-hour free-form window.
WHATSAPP_FOLLOWUP_TEMPLATE=

# ---- Missed call via Exotel ----
# A patient rings the clinic's ExoPhone, Exotel hangs up without connecting, and
# the patient gets a WhatsApp message seconds later. See README, "Missed call via
# Exotel", for the per-clinic setup.
#
# Shared secret appended to the Passthru URL, since Exotel has no other way to
# authenticate. REQUIRED: the route refuses every request (503) while unset,
# rather than falling back to open - it can make us send templates to any number
# a caller supplies, from the clinic's own sender and at the clinic's cost.
# Generate with: openssl rand -hex 32
EXOTEL_WEBHOOK_TOKEN=
# Approved template sent in reply to a missed call. One body variable: the clinic name.
EXOTEL_WELCOME_TEMPLATE=clinic_welcome

# ---- Behaviour ----
# Fallback doctor when an inbound message cannot be mapped to a doctor by phone_number_id
DEFAULT_DOCTOR_ID=
# Conversation session idle timeout
SESSION_TTL_MINUTES=120
# Admin key for onboarding routes (POST /admin/doctor)
ADMIN_API_KEY=change-me
# Published on /privacy and /terms for data questions. Unset is handled, not faked:
# the pages then tell the reader to contact their clinic.
LEGAL_CONTACT_EMAIL=

# ---- Dashboard web login ----
# HMAC key for dashboard session cookies. REQUIRED in production - without a stable
# secret every doctor is silently logged out on each deploy.
# Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_DAYS=7

# ---- Patient document storage ----
# db | s3.  'db' keeps small images as base64 in the documents row and cannot take
# a PDF; 's3' presigns uploads straight to the bucket. The S3_* values are all
# required when STORAGE_DRIVER=s3 - the app refuses to boot otherwise, rather than
# failing at the moment a doctor tries to upload a report.
STORAGE_DRIVER=db
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
